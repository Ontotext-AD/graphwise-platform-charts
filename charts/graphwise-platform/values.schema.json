{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://\\S+$"
            }
          },
          "required": ["url"]
        }
      },
      "required": ["platform"]
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "const": "keycloak"
        }
      }
    }
  },
  "required": ["global"]
}
